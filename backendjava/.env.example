# TMDB API Read Access Token (the long v4 token, sent as Bearer) - https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Spotify API Credentials - Get yours from https://developer.spotify.com/dashboard/applications
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

